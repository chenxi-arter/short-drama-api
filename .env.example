# ===========================================
# 短剧API项目环境变量配置模板
# 复制此文件为 .env 并填入实际配置值
# ===========================================

# ===========================================
# 应用配置
# ===========================================
NODE_ENV=development
PORT=3000
CLIENT_PORT=3000
ADMIN_PORT=8080
APP_TIMEZONE=Asia/Shanghai
# DB_TIMEZONE=+08:00

# ===========================================
# 数据库配置 (MySQL)
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=short_drama_db

# 数据库连接池
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000

# 开发环境可设为 true
DB_SYNCHRONIZE=false
DB_LOGGING=false

# SQLite 模式（可选，不配置 MySQL 时自动启用）
# DB_TYPE=sqlite
# SQLITE_DB_PATH=./data/app.db

# ===========================================
# JWT 认证配置（以下 3 个密钥为启动必需项，缺失/过短/仍是弱值/仍是占位值会直接拒绝启动）
# 生成方式：openssl rand -base64 48
# ⚠️ 下面写的是占位值，进程会**故意**拒绝启动，替换成真实随机串后才能跑起来。
# ===========================================
# 客户端 JWT（必需，至少16位；建议48字节随机）
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 管理后台 JWT（必需，必须与 JWT_SECRET 不同；不再回退到 JWT_SECRET）
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here_at_least_32_characters
ADMIN_JWT_EXPIRES_IN=8h

# 【可选·仅过渡期】旧 JWT 密钥。配置后旧 token 仍可验证，用于平滑迁移；
# 不配置 = 旧 token 全部失效（用户需重新登录），安全性最好。
# 迁移完成后务必删除，不要长期保留。
# JWT_SECRET_LEGACY=
# ADMIN_JWT_SECRET_LEGACY=

# 管理员初始化密钥（首次部署时使用，通过 x-init-admin-token 请求头传入）
INIT_ADMIN_TOKEN=your_one_time_admin_init_token_here

# 应用密钥（必需，用于 HMAC 派生播放地址 accessKey；缺失会导致启动失败）
APP_SECRET=your_app_secret_here

# ===========================================
# Redis 配置
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_USERNAME=

# Redis 缓存
REDIS_TTL=300
REDIS_MAX=100

# Redis 连接（可选）
REDIS_CONNECT_TIMEOUT=5000
REDIS_LAZY_CONNECT=3000
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_DELAY=3000
REDIS_ENABLE_READY_CHECK=true
REDIS_MAX_RETRIES_PER_REQUEST=20000

# ===========================================
# Cloudflare R2 对象存储
# ===========================================
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_BASE_URL=https://static.yourdomain.com

# 允许不安全的外部图片抓取（仅开发环境，生产务必为 false）
ALLOW_INSECURE_EXTERNAL_FETCH=false

# ===========================================
# Telegram Bot 配置
# ===========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_AUTH_MAX_AGE=604800

# ===========================================
# 假评论功能
# ===========================================
ENABLE_FAKE_COMMENTS=true
MIN_FAKE_COMMENTS=30
MAX_FAKE_COMMENTS=50

# ===========================================
# Short.io 短链接服务（必需）
# ===========================================
# Short.io API Key（必需，从 https://app.short.io/ 获取）
SHORT_IO_API_KEY=your_short_io_api_key

# 默认域名（必需，需在 Short.io 控制台预先配置）
SHORT_IO_DEFAULT_DOMAIN=xgtv.short.gy

# 允许创建短链的域名白名单（可选，逗号分隔，支持通配符 *.example.com）
# 如果不配置，则允许所有 HTTPS URL（默认行为）
# 如果配置了，则只允许白名单中的域名
# SHORT_LINK_ALLOWED_DOMAINS=t.me,telegram.me,telegram.org,*.yourdomain.com

# ===========================================
# 播放进度配置
# ===========================================
PROGRESS_MIN_PERCENT=0.01
PROGRESS_MIN_SECONDS=2

# ===========================================
# 调试开关（开发环境可选开启）
# ===========================================
# DEBUG_ENABLED=true
# DEBUG_CACHE=true
# DEBUG_DATABASE=true
# DEBUG_SERVICE=true
# LOG_LEVEL=info

# ===========================================
# 文件上传
# ===========================================
MAX_FILE_SIZE=10485760
